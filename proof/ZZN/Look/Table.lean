  unfold tabAll
  rw [ite_t ⟨hw, hwh, hh⟩]
  interval_cases w <;> interval_cases h
  · simp only [tabCore]; exact ⟨ZZN.LookGen.N11x11.tabRows, ZZN.LookGen.N11x11.tabW⟩
